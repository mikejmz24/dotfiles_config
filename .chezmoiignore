# .chezmoiignore — patterns match TARGET paths (what lands in ~), not source
# names. Write ".config/foo", never "dot_config/foo" or "private_foo".
# `.os` comes from ~/.config/chezmoi/chezmoi.toml ("mac" or "linux").

# Repo files — stay in the repo, run from ~/.local/share/chezmoi, never copied to ~
README.md
install-linux.sh
install-mac.sh
linux-gnome-settings.sh

# Brewfile — Mac only. install-mac.sh and the Mac restore flow use ~/Brewfile.
{{ if ne .os "mac" }}
Brewfile
{{ end }}

# Nordic GTK theming — Ubuntu only
{{ if ne .os "linux" }}
.config/gtk-3.0
.config/gtk-3.0/**
.config/gtk-4.0
.config/gtk-4.0/**
Documents/nordic-theme-reference.css
{{ end }}

# Work credentials — never commit
.gitconfig-work

# Mac-only apps we don't manage
.config/fish/**
.config/zed/**
.config/iterm2/**
.config/uv/**
.config/gh/hosts.yml

# VSCode — managed separately
Library/Application Support/Code/User/globalStorage/**
Library/Application Support/Code/User/workspaceStorage/**
Library/Application Support/Code/User/History/**

# chezmoi config — machine specific, never committed
.config/chezmoi/**

# SSH keys — never commit private keys
.ssh/id_*
.ssh/known_hosts

# VSCode — extensions are machine-specific, never commit
.vscode/**
